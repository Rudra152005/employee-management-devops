# Managed by Puppet - Manual changes will be automatically overwritten and reverted
upstream backend_app {
    server 127.0.0.1:5000;
}

server {
    listen 80 default_server;
    server_name <%= @fqdn %>;

    access_log /var/log/nginx/employee_access.log;
    error_log  /var/log/nginx/employee_error.log;

    location /static/ {
        alias /opt/employee-app/application/app/static/;
        expires 30d;
    }

    location /health {
        proxy_pass http://backend_app/health;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://backend_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
